# RestoMaster OS — Modèle de configuration des variables d'environnement
# Copiez ce fichier vers .env et renseignez vos clés secrètes :
# cp .env.example .env

# =============================================================================
# 1. Configuration Firebase Web SDK (Requis)
# =============================================================================
# Obtenez ces valeurs depuis la Console Firebase > Paramètres du projet > Applications Web
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="votre-projet.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="votre-projet"
VITE_FIREBASE_STORAGE_BUCKET="votre-projet.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# =============================================================================
# 2. Firebase App Check (Recommandé en Production)
# =============================================================================
# Clé de site reCAPTCHA Enterprise configurée dans la Console Firebase > App Check
# VITE_FIREBASE_APPCHECK_KEY="6Lc..."
# VITE_FIREBASE_APPCHECK_DEBUG="false"

# =============================================================================
# 3. Paramètres Applicatifs & Démo
# =============================================================================
# Activer le mode démo uniquement pour les tests ou présentations (false en production)
VITE_DEMO_MODE="false"

# URL publique de l'application (pour webhooks et redirections)
# APP_URL="https://app.restomaster.cm"
