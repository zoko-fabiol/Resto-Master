# RestoMaster OS — Modèle de configuration des variables d'environnement
# Copiez ce fichier vers .env et renseignez vos clés réelles :
# cp .env.example .env
#
# AVERTISSEMENT DE SÉCURITÉ :
# Ne commitez JAMAIS le fichier .env ni aucune clé privée / secrète dans le dépôt.

# =============================================================================
# 1. Configuration Firebase Web SDK (Obligatoire)
# =============================================================================
# Obtenez ces valeurs depuis : Console Firebase > Paramètres du projet > Applications Web
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="votre-projet.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="votre-projet"
VITE_FIREBASE_STORAGE_BUCKET="votre-projet.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# =============================================================================
# 2. Cloud Functions & Émulateurs Locaux (Optionnel / Dev)
# =============================================================================
# Basculer l'exécution métier vers Cloud Functions v2 (recommandé en prod)
VITE_USE_CLOUD_FUNCTIONS="true"

# Activer la redirection vers les émulateurs locaux Firebase (Auth: 9099, Firestore: 8080, Functions: 5001)
# Uniquement actif si VITE_USE_EMULATORS="true" et environnement non-production
VITE_USE_EMULATORS="false"

# =============================================================================
# 3. Firebase App Check (Recommandé en Production)
# =============================================================================
# Clé de site reCAPTCHA Enterprise configurée dans Console Firebase > App Check
VITE_FIREBASE_APPCHECK_KEY=""
VITE_FIREBASE_APPCHECK_DEBUG="false"

# =============================================================================
# 4. Service d'envoi d'e-mails opérationnels (Google Apps Script Webhook)
# =============================================================================
# Webhook déployé pour la notification d'accueil, réinitialisation de code PIN, reçus
VITE_GAS_WEBHOOK_URL=""

# =============================================================================
# 5. CDN & Stockage Médias (Cloudinary - Optionnel)
# =============================================================================
# Pour l'hébergement optimisé des photos des plats, logos et documents
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""
VITE_CLOUDINARY_API_KEY=""

# =============================================================================
# 6. Paramètres Applicatifs & Déploiement
# =============================================================================
# URL publique de l'application (pour webhooks et redirections)
# APP_URL="https://app.votrerestaurant.cm"
