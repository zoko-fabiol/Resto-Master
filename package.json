{
  "name": "restomaster-os",
  "private": true,
  "version": "1.0.0",
  "description": "Système de gestion intégrée de restaurant",
  "author": "RestoMaster",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:admin": "vite --config admin-panel/vite.config.ts",
    "dev:electron": "concurrently -k \"vite --port=3000\" \"wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "electron:start": "electron .",
    "build:electron": "npm run clean:dist && vite build --mode electron && npm run check:dist -- --mode electron",
    "package:electron": "npm run build:electron && electron-builder --config electron-builder.json",
    "clean:dist": "tsx scripts/clean-dist.ts",
    "check:dist": "tsx scripts/check-dist.ts",
    "build:tauri": "npm run clean:dist && vite build --mode tauri && npm run check:dist -- --mode tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "firebase:use": "firebase use resto-master-310f7",
    "firebase:check": "firebase projects:list",
    "emulators:start": "firebase emulators:start",
    "firebase:deploy:functions": "firebase deploy --only functions --project resto-master-310f7",
    "firebase:deploy": "firebase deploy --only firestore:rules,functions --project resto-master-310f7",
    "setup:verify": "npm run check:tauri && npm run firebase:check",
    "prebuild": "tsx scripts/check-build-env.ts && tsx scripts/check-no-demo.ts",
    "check:tauri": "tsx scripts/check-tauri-env.ts && npm run check:dist -- --mode tauri",
    "check:demo": "tsx scripts/check-no-demo.ts",
    "create:superadmin": "tsx scripts/create-superadmin.ts",
    "build": "npm run clean:dist && vite build",
    "build:admin": "vite build --config admin-panel/vite.config.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:phase1": "tsx scripts/verify-phase1.ts",
    "test:phase2": "tsx scripts/verify-phase2-fiscal.ts",
    "test:config-phase1": "tsx scripts/verify-phase1-persistence.ts",
    "test:config-phase2": "tsx scripts/verify-phase2-settings.ts",
    "test:config-phase3": "tsx scripts/verify-phase3-connected.ts",
    "test:config-phase4": "tsx scripts/verify-phase4-permissions.ts",
    "test:phase-h": "tsx scripts/verify-phase-h-finance.ts",
    "test:rules": "tsx scripts/run-test-rules.ts",
    "audit:config": "tsx scripts/audit-config.ts",
    "purge:test-data": "tsx scripts/purge-test-data.ts",
    "migrate:user-access": "tsx scripts/migrate-user-access.ts",
    "release:zip": "tsx scripts/make-release-zip.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "docx": "^9.12.0",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
