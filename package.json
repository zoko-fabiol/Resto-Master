{
  "name": "restomaster-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:admin": "vite --config admin-panel/vite.config.ts",
    "prebuild": "tsx scripts/check-build-env.ts && tsx scripts/check-no-demo.ts",
    "check:demo": "tsx scripts/check-no-demo.ts",
    "create:superadmin": "tsx scripts/create-superadmin.ts",
    "build": "vite build",
    "build:admin": "vite build --config admin-panel/vite.config.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:phase1": "tsx scripts/verify-phase1.ts",
    "test:phase2": "tsx scripts/verify-phase2-fiscal.ts",
    "test:config-phase1": "tsx scripts/verify-phase1-persistence.ts",
    "test:config-phase2": "tsx scripts/verify-phase2-settings.ts",
    "test:config-phase3": "tsx scripts/verify-phase3-connected.ts",
    "test:config-phase4": "tsx scripts/verify-phase4-permissions.ts",
    "test:phase-h": "tsx scripts/verify-phase-h-finance.ts",
    "audit:config": "tsx scripts/audit-config.ts",
    "purge:test-data": "tsx scripts/purge-test-data.ts",
    "release:zip": "tsx scripts/make-release-zip.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "docx": "^9.12.0",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-admin": "^14.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
